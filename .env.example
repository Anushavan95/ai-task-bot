# App runtime ports
PORT=4000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL
POSTGRES_DB=ai_task_bot
POSTGRES_USER=ai_task_bot
POSTGRES_PASSWORD=change_me

# Docker service URLs: use service names inside containers, localhost only for browser access
DATABASE_URL=postgresql://ai_task_bot:change_me@postgres:5432/ai_task_bot?schema=public
REDIS_URL=redis://redis:6379

# Telegram and backend runtime
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
INTERNAL_EVENTS_TOKEN=replace_this_with_a_random_secret
FRONTEND_URL=http://localhost:3000
REALTIME_SERVER_URL=http://api:4000
CORS_ORIGIN=http://localhost:3000

# Browser-safe frontend values (must remain localhost for the host browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Optional: not required for the current local Whisper transcription flow
OPENAI_API_KEY=
