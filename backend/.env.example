# PostgreSQL connection string
# For Docker, use the service name `postgres`; for local development, use `localhost`.
DATABASE_URL=postgresql://ai_task_bot:yourpassword@postgres:5432/ai_task_bot?schema=public

# Redis connection string
REDIS_URL=redis://redis:6379

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
INTERNAL_EVENTS_TOKEN=generate_a_random_secret_token

FRONTEND_URL=http://localhost:3000
REALTIME_SERVER_URL=http://localhost:4000

OPENAI_API_KEY=
